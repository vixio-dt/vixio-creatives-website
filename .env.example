# Supabase project URL (server-side preferred; NEXT_PUBLIC_SUPABASE_URL is the fallback)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase anonymous key (server-side preferred; NEXT_PUBLIC_SUPABASE_ANON_KEY is the fallback)
SUPABASE_ANON_KEY=your-anon-key-here

# Resend API key — optional; without it the contact API skips the notification email
RESEND_API_KEY=re_YOUR_KEY_HERE
